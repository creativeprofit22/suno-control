{
  "name": "suno-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/main.js",
    "assist": "npm run build && node dist/src/assist-cli.js",
    "smoke:live": "npm run build && node dist/src/smoke-cli.js",
    "test": "npm run build --silent && node test/roadmap-runner.mjs",
    "test:queue": "node --test dist/test/queue.test.js",
    "test:limits": "node --test --test-name-pattern=\"explicit concurrency|enforcement stops|retries one|never retries\" dist/test/queue.test.js",
    "test:diagnostics": "node --test dist/test/diagnostics.test.js",
    "test:cli": "node --test dist/test/cli.test.js",
    "test:smoke-boundary": "node --test dist/test/smoke-boundary.test.js",
    "test:smoke": "node --test --test-name-pattern=\"live smoke\" dist/test/submission.test.js dist/test/smoke-boundary.test.js",
    "test:docs": "node --test dist/test/readme.test.js",
    "verify:roadmap-1": "node --test --test-name-pattern=\"sequential default|terminal restart\" dist/test/queue.test.js",
    "verify:roadmap-2": "node --test --test-name-pattern=\"explicit concurrency|enforcement stops|retries one|never retries\" dist/test/queue.test.js",
    "verify:roadmap-3": "node --test dist/test/diagnostics.test.js",
    "verify:roadmap-4": "node --test --test-name-pattern=\"live smoke\" dist/test/submission.test.js dist/test/smoke-boundary.test.js",
    "verify:roadmap-5": "node --test dist/test/readme.test.js",
    "test:baseline-1": "node --test --test-name-pattern=\"criterion 1 baseline\" test/phase-baseline.test.mjs",
    "test:baseline-2": "node --test --test-name-pattern=\"criterion 2 fresh live\" test/phase-baseline-live.mjs",
    "test:baseline-3": "node --test --test-name-pattern=\"criterion 3 architecture modules\" test/phase-baseline.test.mjs",
    "test:baseline-4": "node --test --test-name-pattern=\"source dependency graph\" test/architecture.test.mjs",
    "test:baseline-5": "node --test --test-name-pattern=\"architecture guards reject\" test/architecture.test.mjs",
    "test:baseline-6": "node --test --test-name-pattern=\"criterion 6 architecture document\" test/phase-baseline.test.mjs",
    "test:unit": "npm run verify:roadmap-1",
    "test:integration": "npm run verify:roadmap-2",
    "check": "npm run verify:roadmap-3",
    "test:e2e": "npm run verify:roadmap-4",
    "lint:check": "npm run verify:roadmap-5",
    "install-browser": "playwright install chromium",
    "test:phase-command": "node --test --test-name-pattern=\"documented command starts\" test/phase-completion.test.mjs",
    "test:phase-profile": "node --test --test-name-pattern=\"visible persistent Chromium\" test/phase-completion.test.mjs",
    "test:phase-ignores": "node --test --test-name-pattern=\"runtime profile downloads\" test/phase-completion.test.mjs",
    "test:phase-secrets": "node --test --test-name-pattern=\"no cookie JWT\" test/phase-completion.test.mjs",
    "test:phase-login": "node --test --test-name-pattern=\"manual authentication reports\" test/phase-completion.test.mjs",
    "test:phase-completion-1": "node --test --test-name-pattern=\"criterion 1 completion tracking\" dist/test/completion.test.js dist/test/tracking.test.js",
    "test:phase-completion-2": "node --test --test-name-pattern=\"criterion 2 Playwright downloads\" dist/test/completion.test.js",
    "test:phase-completion-3": "node --test --test-name-pattern=\"criterion 3 downloaded files\" dist/test/completion.test.js",
    "test:phase-completion-4": "node --test --test-name-pattern=\"criterion 4\" dist/test/completion.test.js dist/test/run-jobs.test.js dist/test/tracking.test.js",
    "test:phase-completion-5": "node --test --test-name-pattern=\"criterion 5\" dist/test/run-jobs.test.js dist/test/tracking.test.js"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
